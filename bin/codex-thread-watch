#!/usr/bin/python3
"""Register the calling Claude Code session to hear when Codex threads finish turns.

Usage: codex-thread-watch [--block [--all] [--timeout SECONDS]] THREAD_ID...

For each thread, records the nearest ancestor Claude Code session as the thread's
owner in ~/.codex/claude-notify/<thread-id>. The Codex Stop hook
(~/.local/bin/codex-notify-claude) then sends that session a cross-session message
from "codex-hook" every time a turn ends. No polling and no expiry: do not re-arm.

A thread that is already idle (its last turn ended) is reported immediately,
so a turn that finished before registration is never missed.

--block also waits, after registering, until a watched thread is idle (with
--all, every one), printing each one's summary as it goes idle. Run it in the
background for one completion notice. --timeout ends the wait with status 2.
"""
import glob, json, os, subprocess, sys, time
from pathlib import Path

HOME = Path.home()


def claude_session():
    pid = os.getpid()
    while pid > 1:
        meta = HOME / ".claude" / "sessions" / f"{pid}.json"
        if meta.exists():
            return json.loads(meta.read_text())["sessionId"]
        out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True)
        try:
            pid = int(out.stdout.strip())
        except ValueError:
            break
    sys.exit("codex-thread-watch: not running under a Claude Code session")


def rollout(thread_id):
    files = sorted(glob.glob(str(HOME / ".codex" / "sessions" / "*" / "*" / "*" / f"rollout-*{thread_id}*.jsonl")))
    return files[-1] if files else None


def finished_turn(path):
    started = ended = 0
    last, error = "", None
    for line in open(path, errors="replace"):
        try:
            payload = json.loads(line).get("payload", {})
        except ValueError:
            continue
        kind = payload.get("type")
        if kind == "task_started":
            started += 1
        elif kind in ("task_complete", "turn_aborted"):
            ended += 1
            error = (payload.get("error") or {}).get("message") if kind == "task_complete" else "aborted"
        elif kind == "message" and payload.get("role") == "assistant":
            last = "".join(c.get("text", "") for c in payload.get("content", []) if isinstance(c, dict))
    if started and ended >= started:
        return (" ERROR " + error if error else "") + ": " + last[:600].replace("\n", " ")
    return None


def main(argv):
    block = wait_all = False
    timeout = None
    ids = []
    args = iter(argv)
    for arg in args:
        if arg == "--block":
            block = True
        elif arg == "--all":
            wait_all = True
        elif arg == "--timeout":
            timeout = float(next(args, "0"))
        else:
            ids.append(arg)
    if not ids or (wait_all or timeout is not None) and not block:
        sys.exit(__doc__)
    session = claude_session()
    registry = HOME / ".codex" / "claude-notify"
    registry.mkdir(parents=True, exist_ok=True)
    pending = []
    for thread_id in ids:
        path = rollout(thread_id)
        if path is None:
            sys.exit(f"{thread_id}: no rollout file")
        (registry / thread_id).write_text(session + "\n")
        done = finished_turn(path)
        if done is not None:
            print(f"{thread_id} turn complete{done}")
        else:
            pending.append(thread_id)
    if pending:
        print(f"Registered {' '.join(pending)}: each turn end arrives as a cross-session "
              "message from codex-hook. No polling, no expiry; do not re-arm.", flush=True)
    if not block or not pending or (not wait_all and len(pending) < len(ids)):
        return
    deadline = None if timeout is None else time.monotonic() + timeout
    while pending:
        for thread_id in list(pending):
            done = finished_turn(rollout(thread_id))
            if done is not None:
                print(f"{thread_id} turn complete{done}", flush=True)
                pending.remove(thread_id)
        if pending and not wait_all and len(pending) < len(ids):
            return
        if pending and deadline is not None and time.monotonic() >= deadline:
            print(f"Timed out waiting for {' '.join(pending)}", flush=True)
            sys.exit(2)
        if pending:
            time.sleep(2)


main(sys.argv[1:])
