+def register_thread_owner(thread_id: str):
+    """Record the launching Claude session beside this server's worker history."""
+    try:
+        pid = os.getpid()
+        while pid > 1:
+            meta = Path.home() / ".claude" / "sessions" / f"{pid}.json"
+            if meta.exists():
+                session = json.loads(meta.read_text())
+                codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
+                registry = codex_home / "claude-notify"
+                registry.mkdir(parents=True, exist_ok=True)
+                (registry / thread_id).write_text(session["sessionId"] + "\n")
+                return
+            parent = subprocess.check_output(["ps", "-o", "ppid=", "-p", str(pid)], text=True)
+            pid = int(parent.strip())
+    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
+        pass
 
 
